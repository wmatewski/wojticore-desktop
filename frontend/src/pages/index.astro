---
import Layout from '../layouts.astro';
---
<Layout>
  <div class="site-shell">
    <header class="topnav">
      <a class="brand" href="/" aria-label="Wojticore Desktop home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 21 7.9v8.2L12 21.2 3 16.1V7.9l9-5.1Z" stroke="white" stroke-width="1.4"/><path d="m3.5 8 8.5 4.8L20.5 8M12 12.8v8" stroke="white" stroke-width="1.2"/></svg></span>Wojticore</a>
      <nav class="nav-links" aria-label="Main navigation"><a href="/#overview">Overview</a><a href="/installation/">Installation</a><a href="/packages/">Packages</a><a href="https://github.com/wmatewski/wojticore-desktop">GitHub</a></nav>
      <a class="button button-primary nav-cta" href="/installation/">Get started</a>
    </header>
    <main>
      <section class="hero" id="overview">
        <h1>A desktop that feels like <span>glass.</span></h1>
        <p class="hero-copy">An open Linux desktop built around Hyprland, Quickshell, and a calm, cohesive interface.</p>
        <div class="hero-actions"><a class="button button-primary" href="/packages/">Explore the project</a><a class="button button-quiet" href="https://github.com/wmatewski/wojticore-desktop">View source</a></div>
        <div class="desktop-preview" role="img" aria-label="Glass Desktop workspace with a top bar, application launcher and floating dock">
          <div class="desktop-screen">
            <img class="desktop-wallpaper" src="/glass-wallpaper.png" alt="Abstract blue and violet liquid glass wallpaper" />
            <div class="mock-bar"><div class="mock-brand"><span class="brand-mark"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 21 7.9v8.2L12 21.2 3 16.1V7.9l9-5.1Z" stroke="white" stroke-width="1.4"/></svg></span>Wojticore</div><div class="workspaces"><span class="workspace-current">1</span><span>2</span><span>3</span><span>4</span></div><div class="system-states"><span>Thu, Jan 23&nbsp; 20:17</span><svg viewBox="0 0 20 20"><path d="M2 7.5a12 12 0 0 1 16 0M5 10.5a7.5 7.5 0 0 1 10 0M8.3 13.5a2.7 2.7 0 0 1 3.4 0M10 16.5h.01"/></svg><svg viewBox="0 0 20 20"><path d="M3 8h3l4-3v10l-4-3H3zM13 8a3 3 0 0 1 0 4M14.5 6a6 6 0 0 1 0 8"/></svg><svg viewBox="0 0 20 20"><rect x="2.5" y="5" width="14" height="10" rx="2"/><path d="M18 8v4"/></svg></div></div>
            <div class="launcher-preview"><div class="search-row"><svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg>Search applications…</div><div class="app-list"><div class="app-item"><span class="app-icon">◉</span><span class="app-meta">Firefox<small>Web browser</small></span></div><div class="app-item"><span class="app-icon">&gt;_</span><span class="app-meta">Terminal<small>Command line</small></span></div><div class="app-item"><span class="app-icon">▰</span><span class="app-meta">Files<small>File manager</small></span></div><div class="app-item"><span class="app-icon">▤</span><span class="app-meta">Text Editor<small>Edit text files</small></span></div></div></div>
            <div class="dock-preview" aria-hidden="true"><span class="dock-icon">◉</span><span class="dock-icon">&gt;_</span><span class="dock-icon">▰</span><span class="dock-icon">▤</span><span class="dock-icon">⚙</span><i class="dock-separator"></i><span class="dock-icon">⠿</span></div>
          </div>
        </div>
      </section>
      <section class="features" aria-label="Project principles"><div class="feature">One focused session</div><div class="feature">Independent RPM packages</div><div class="feature">Open by design</div></section>
      <section class="section split-section" id="installation">
        <div><h2 class="section-heading">Start with a clean slate.</h2><p class="section-copy">Install the Glass session alongside your current desktop. Your existing Hyprland, KDE and GNOME setups stay where they are.</p><p style="margin-top:24px"><a class="button button-primary" href="/installation/">Installation guide</a></p></div>
        <div class="terminal"><div class="terminal-head"><i class="terminal-dot"></i><i class="terminal-dot"></i><i class="terminal-dot"></i><span class="terminal-title">Fedora · shell</span></div><div class="terminal-body"><div><span>$</span> curl -fsSL https://desktop.wojticore.eu/install.sh | sudo bash</div><div style="color:#8e9aba">Installs the Glass Desktop session and required packages.</div></div></div>
      </section>
    </main>
    <footer class="footer"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">W</span>Wojticore</a><nav class="footer-links" aria-label="Footer"><a href="/installation/">Installation</a><a href="/releases/">Releases</a><a href="https://github.com/wmatewski/wojticore-desktop">GitHub</a></nav></footer>
  </div>
</Layout>
