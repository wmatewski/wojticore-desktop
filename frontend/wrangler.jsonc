{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wojticore-desktop",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "wojticore-desktop",
      "routes": [{ "pattern": "desktop.wojticore.eu/*", "zone_name": "wojticore.eu" }]
    }
  }
}
